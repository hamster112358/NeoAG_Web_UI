[Unit]
# RETIRED 2026-11-18 - kept for reference only, NOT installed or monitored.
# Dependency audit found no external client of the CodeBuddy Gateway:
# NeoAG Web talks to it over loopback, the frontend makes no external
# calls, nothing on the host references a gateway public hostname, and
# the operator uses CodeBuddy through SSH/tmux. To re-adopt: copy to
# ~/.config/systemd/user, re-add a "gw" TUNNELS entry in tunnelctl.py,
# daemon-reload + enable --now. Original rationale below.
#
# Quick Tunnel for the CodeBuddy Gateway: Cloudflare edge -> 127.0.0.1:7890.
# Kept separate from the Web tunnel on purpose: its client is the operator's
# browser opening the CodeBuddy chat UI directly (NeoAG Web itself reaches
# the gateway over loopback and never uses this URL). --http-host-header is
# REQUIRED: the gateway's DNS-rebinding middleware only accepts Host values
# on its allow-list (localhost:7890), and quick-tunnel requests would
# otherwise be rejected 403. Do not weaken the middleware instead.
Description=CodeBuddy Gateway quick tunnel (Cloudflare -> 127.0.0.1:7890)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/data1/neoag/agents/cloudflared/bin/cloudflared tunnel --no-autoupdate --protocol http2 --http-host-header localhost:7890 --url http://127.0.0.1:7890
Restart=always
RestartSec=10
TimeoutStopSec=20
UMask=0077
StandardOutput=append:/data1/neoag/agents/remote_access/tunnels/gw.log
StandardError=append:/data1/neoag/agents/remote_access/tunnels/gw.log

[Install]
WantedBy=default.target
